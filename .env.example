# Application metadata
APP_NAME=E-Commerce API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_PREFIX=/api

# PostgreSQL / MySQL connection string
# SQLite by default; swap to e.g. postgresql+psycopg://user:pass@host:5432/shop
DATABASE_URL=sqlite:///./ecommerce.db

# JWT settings - generate a strong random secret.
# The placeholder below is intentionally rejected by the app: it will refuse
# to start until you replace it (run: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limiting (per client IP per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=20
CHANGE_PASSWORD_RATE_LIMIT_PER_MINUTE=10

# AUTO_CREATE_TABLES: defaults to enabled for SQLite dev only. Set to 1/true
# to also run create_all against another database, or 0/false to disable it.
# AUTO_CREATE_TABLES=false