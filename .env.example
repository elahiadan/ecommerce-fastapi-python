# Database URL. SQLite by default; switch to Postgres with e.g.:
# DATABASE_URL=postgresql+psycopg://shop:secret@localhost:5432/shop
DATABASE_URL=sqlite:///./ecommerce.db

# JWT signing key. REQUIRED — the app refuses to start without it. Never use a
# placeholder value; the default is intentionally rejected. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440